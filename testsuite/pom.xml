<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.excelacom.jdiameter</groupId>
    <artifactId>diameter-parent</artifactId>
    <version>1.7.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <packaging>pom</packaging>

  <groupId>com.excelacom.jdiameter.testsuite</groupId>
  <artifactId>testsuite-parent</artifactId>

  <name>Excelacom :: Diameter Testsuite :: ${project.artifactId}</name>

  <properties>
    <!-- Third party -->
    <get.opt.version>1.0.9</get.opt.version>
    <picocontainer.version>2.16</picocontainer.version>
    <slf4j.version>2.0.17</slf4j.version>
    <reload4j.version>1.2.27</reload4j.version>
    <junit.version>4.13.2</junit.version>
    <version.surefire>2.19</version.surefire>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- pins the JBoss 5 dependency tree (previously inherited from the Restcomm parent) -->
      <dependency>
        <groupId>org.jboss.jbossas</groupId>
        <artifactId>jboss-as-component-matrix</artifactId>
        <version>5.1.0.GA</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- CORE DEPENDENCIES -->
      <dependency>
        <groupId>com.excelacom.jdiameter</groupId>
        <artifactId>jdiameter-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.excelacom.jdiameter</groupId>
        <artifactId>jdiameter-impl</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.excelacom.jdiameter</groupId>
        <artifactId>jdiameter-ha-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.excelacom.jdiameter</groupId>
        <artifactId>jdiameter-ha-impl</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.excelacom.jdiameter</groupId>
        <artifactId>jdiameter-mux-jar</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.picocontainer</groupId>
        <artifactId>picocontainer</artifactId>
        <version>${picocontainer.version}</version>
      </dependency>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>urbanophile</groupId>
        <artifactId>java-getopt</artifactId>
        <version>${get.opt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-reload4j</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>default</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>tests</module>
      </modules>
    </profile>
    <profile>
      <id>load</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <modules>
        <module>load</module>
      </modules>
    </profile>
  </profiles>


</project>
